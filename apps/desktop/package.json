{
  "name": "@meridian/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian as an installable Windows application.",
  "main": "src/main.cjs",
  "scripts": {
    "start": "node src/launch.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "check": "node src/launch.cjs --probe"
  },
  "build": {
    "appId": "pk.meridian.app",
    "productName": "Meridian",
    "files": [
      "src/**/*",
      "web/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
