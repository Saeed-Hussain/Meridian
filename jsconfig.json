{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "packages/**/*.js",
    "server/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/.next",
    "apps"
  ]
}
