{
  "name": "meridian",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.js\"",
    "test:watch": "node --test --watch \"packages/*/test/*.test.js\"",
    "typecheck": "tsc --noEmit -p jsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3"
  }
}
